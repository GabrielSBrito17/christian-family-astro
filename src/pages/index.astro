---
import Layout from '../layouts/Layout.astro';
import logoUrl from "../assets/images/logo2.png";
import logoWatermark from "../assets/images/logo.png";

const churchName = "Igreja Christian Family";

const cultos = [
  { 
    nome: "Domingo de Celebração", 
    dia: "Domingo", 
    horarios: [
      { rotulo: "Pequeno Almoço", hora: "09:00 - 09:45" },
      { rotulo: "Culto Principal", hora: "10:00 & 18:00" }
    ],
    descricao: "Louvor, comunhão, pequeno almoço em família e palavra transformadora." 
  },
  { 
    nome: "Culto o Altar Responde", 
    dia: "Sexta-feira", 
    horarios: [{ rotulo: "Culto", hora: "20:00" }],
    descricao: "Noite de oração, busca pelo Espírito Santo e clamor." 
  },
  { 
    nome: "Terça da Benção", 
    dia: "Terça-feira", 
    horarios: [{ rotulo: "Oração", hora: "20:00" }],
    descricao: "Intercessão pelas famílias, igreja e pedidos de oração." 
  },
  { 
    nome: "Encontro de Jovens", 
    dia: "Sábado", 
    horarios: [{ rotulo: "Jovens", hora: "19:30" }],
    descricao: "Comunhão, louvor jovem e mensagens práticas." 
  },
];

const eventos = [
  {
    titulo: "Conferência Global 2026",
    data: "15 a 17 de Outubro",
    local: "Auditório Principal",
    imagem: "https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?auto=format&fit=crop&w=800&q=80",
    tag: "Conferência",
    descricao: "Três dias de imersão, adoração e palavra com convidados especiais. Garanta sua vaga."
  },
  {
    titulo: "Retiro de Jovens: Conectados",
    data: "20 a 22 de Novembro",
    local: "Acampamento Quinta do Sol",
    imagem: "https://images.unsplash.com/photo-1523580494863-6f3031224c94?auto=format&fit=crop&w=800&q=80",
    tag: "Retiro",
    descricao: "O nosso retiro anual de jovens. Tempo focado em comunhão, dinâmicas e crescimento espiritual."
  }
];
---

<Layout title={`${churchName} | Bem-vindo`}>
  
  <!-- CABEÇALHO / NAVEGAÇÃO -->
  <header class="bg-igreja-preto text-igreja-branco sticky top-0 z-50 border-b border-igreja-terra/40 shadow-lg">
    <div class="max-w-6xl mx-auto px-4 h-20 flex items-center justify-between">
      <!-- LOGO E NOME DA IGREJA -->
      <a href="#" class="flex items-center gap-3 group">
        <div class="bg-igreja-terra p-2 rounded-xl group-hover:bg-igreja-laranja transition duration-300">
          <img src={logoUrl.src} alt="Logo" class="h-8 w-8 filter invert" />
        </div>
        <span class="font-black text-xl tracking-wide text-igreja-dourado group-hover:text-igreja-laranja transition duration-300">
          {churchName}
        </span>
      </a>

      <!-- MENU DE NAVEGAÇÃO -->
      <nav class="hidden md:flex items-center gap-8 font-medium text-igreja-branco/80 text-sm">
        <a href="#" class="hover:text-igreja-dourado transition">Início</a>
        <a href="#agenda" class="hover:text-igreja-dourado transition">Cultos</a>
        <a href="#eventos" class="hover:text-igreja-dourado transition">Eventos</a>
        <a href="/admin" class="bg-igreja-terra/40 text-igreja-dourado border border-igreja-dourado/30 px-4 py-2 rounded-lg hover:bg-igreja-terra transition">
          Painel CMS
        </a>
      </nav>

      <!-- BOTÃO DE AÇÃO -->
      <a href="#eventos" class="bg-igreja-laranja hover:bg-igreja-dourado text-igreja-branco font-bold text-xs uppercase tracking-wider px-5 py-3 rounded-full shadow-md transition duration-300">
        Participar
      </a>
    </div>
  </header>

  <!-- HERO SECTION COM MARCA D'ÁGUA RESPONSIVA -->
  <section class="bg-igreja-preto text-igreja-branco py-20 sm:py-28 px-4 text-center relative overflow-hidden border-b border-igreja-terra/40">
    
    <!-- MARCA D'ÁGUA (PERFEITAMENTE CENTRALIZADA E RESPONSIVA) -->
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none z-0 p-6">
      <img 
        src={logoWatermark.src} 
        alt="" 
        aria-hidden="true" 
        class="w-full max-w-[280px] sm:max-w-[420px] md:max-w-[550px] lg:max-w-[650px] h-auto object-contain mix-blend-screen opacity-10 filter blur-[0.5px]" 
      />
    </div>

    <!-- CONTEÚDO PRINCIPAL DA HERO (FICA ACIMA DA MARCA D'ÁGUA) -->
    <div class="max-w-3xl mx-auto space-y-6 relative z-10">
      <div class="inline-flex items-center gap-2 bg-igreja-preto/60 border border-igreja-dourado/40 text-igreja-dourado px-4 py-2 rounded-full text-xs font-bold uppercase tracking-widest backdrop-blur-sm">
        <span>Lugar de Fé & Comunhão</span>
      </div>

      <h1 class="text-3xl sm:text-5xl md:text-6xl font-black tracking-tight leading-tight text-igreja-branco">
        Uma igreja de braços abertos para <span class="text-igreja-dourado">você</span>
      </h1>
      
      <p class="text-base sm:text-lg text-igreja-branco/90 max-w-2xl mx-auto leading-relaxed">
        Venha fazer parte da nossa família. Confira nossos horários de cultos semanais e os próximos eventos programados.
      </p>

      <div class="pt-4 flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#agenda" class="bg-igreja-laranja hover:bg-igreja-dourado text-igreja-branco font-bold px-8 py-4 rounded-xl shadow-lg transition duration-300 text-sm">
          Ver Horários dos Cultos
        </a>
        <a href="#eventos" class="bg-igreja-preto/80 hover:bg-igreja-preto text-igreja-branco border border-igreja-dourado/40 font-bold px-8 py-4 rounded-xl transition duration-300 text-sm">
          Próximos Eventos
        </a>
      </div>
    </div>
  </section>

  <!-- AGENDA DE CULTOS -->
  <section id="agenda" class="bg-igreja-branco max-w-6xl mx-auto px-4 py-20 scroll-mt-12">
    <div class="text-center max-w-xl mx-auto mb-14">
      <span class="text-igreja-laranja text-xs font-extrabold uppercase tracking-widest bg-igreja-laranja/10 px-3 py-1.5 rounded-full border border-igreja-laranja/20">
        Programação Semanal
      </span>
      <h2 class="text-3xl font-extrabold text-igreja-preto tracking-tight mt-3">Nossos Cultos</h2>
      <p class="text-igreja-preto/70 mt-2">Participe conosco presencialmente nos seguintes horários.</p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {cultos.map((culto) => (
        <div class="bg-igreja-branco border-2 border-igreja-terra/20 p-6 rounded-2xl shadow-sm hover:shadow-xl hover:border-igreja-dourado transition duration-300 flex flex-col justify-between">
          <div>
            <!-- Header do Card: Dia da Semana -->
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-extrabold uppercase tracking-wider text-igreja-branco bg-igreja-terra px-3 py-1 rounded-md">
                {culto.dia}
              </span>
            </div>

            <!-- Título do Evento -->
            <h3 class="text-xl font-bold text-igreja-preto">{culto.nome}</h3>
            
            <!-- Descrição -->
            <p class="text-igreja-preto/70 text-xs mt-2 leading-relaxed">{culto.descricao}</p>

            <!-- Bloco de Horários Detalhados -->
            <div class="mt-4 pt-4 border-t border-igreja-terra/10 space-y-2">
              {culto.horarios.map((h) => (
                <div class="flex items-center justify-between text-xs bg-igreja-terra/5 p-2 rounded-lg border border-igreja-terra/10">
                  <span class="font-bold text-igreja-preto/80">{h.rotulo}</span>
                  <span class="font-bold text-igreja-laranja">🕒 {h.hora}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Rodapé do Card -->
          <div class="mt-6 pt-4 border-t border-igreja-terra/10 flex items-center justify-between text-xs font-bold text-igreja-laranja">
            <span>Presencial</span>
            <span>&rarr;</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- EVENTOS E RETIROS -->
  <section id="eventos" class="bg-igreja-preto text-igreja-branco py-20 border-t border-igreja-terra/40 scroll-mt-12">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center max-w-xl mx-auto mb-14">
        <span class="text-igreja-dourado text-xs font-bold uppercase tracking-widest bg-igreja-dourado/10 px-3 py-1.5 rounded-full border border-igreja-dourado/30">
          Calendário Especial
        </span>
        <h2 class="text-3xl font-extrabold text-igreja-branco tracking-tight mt-3">Eventos e Retiros</h2>
        <p class="text-igreja-branco/70 mt-2">Fique por dentro das conferências e passeios da igreja.</p>
      </div>

      <div class="grid gap-8 md:grid-cols-2 max-w-4xl mx-auto">
        {eventos.map((evento) => (
          <div class="bg-igreja-branco text-igreja-preto rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition duration-300 border border-igreja-dourado/30 flex flex-col">
            <div class="relative h-56 bg-igreja-terra">
              <img
                src={evento.imagem}
                alt={evento.titulo}
                class="w-full h-full object-cover"
                loading="lazy"
              />
              <span class="absolute top-4 left-4 bg-igreja-preto text-igreja-dourado text-xs font-bold px-3 py-1 rounded-full shadow-md border border-igreja-dourado/40">
                {evento.tag}
              </span>
            </div>
            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center text-xs font-bold text-igreja-laranja gap-2">
                  <span>📅 {evento.data}</span>
                  <span class="text-igreja-preto/30">•</span>
                  <span class="text-igreja-preto/60">📍 {evento.local}</span>
                </div>
                <h3 class="text-2xl font-bold text-igreja-preto mt-3 tracking-tight">{evento.titulo}</h3>
                <p class="text-igreja-preto/70 mt-2 text-sm leading-relaxed">{evento.descricao}</p>
              </div>
              <button class="w-full mt-6 bg-igreja-laranja hover:bg-igreja-dourado text-igreja-branco font-bold py-3 rounded-xl text-sm transition duration-300 shadow-md">
                Garantir Inscrição
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- RODAPÉ COM LOGO DA IGREJA -->
  <footer class="bg-igreja-preto text-igreja-branco/60 py-12 border-t border-igreja-terra/30">
    <div class="max-w-6xl mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-3">
        <img src={logoUrl.src} alt="Logo Rodapé" class="h-6 w-6 filter invert opacity-80" />
        <span class="font-bold text-igreja-dourado tracking-wide">{churchName}</span>
      </div>
      <p class="text-xs text-igreja-branco/50">&copy; 2026 {churchName}. Todos os direitos reservados.</p>
    </div>
  </footer>

</Layout>